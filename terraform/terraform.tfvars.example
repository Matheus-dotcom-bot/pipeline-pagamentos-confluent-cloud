confluent_cloud_api_key    = ""
confluent_cloud_api_secret = ""

confluent_environment_id = "env-xxxxxxxx"
kafka_cluster_id         = "lkc-xxxxxxxx"
kafka_rest_endpoint      = "https://pkc-xxxxxxxx.region.provider.confluent.cloud:443"
