# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=payments
POSTGRES_USER=payments
POSTGRES_PASSWORD=payments

# Kafka / Confluent Cloud
KAFKA_BOOTSTRAP_SERVERS=pkc-xxxxx.region.provider.confluent.cloud:9092
KAFKA_API_KEY=replace_me
KAFKA_API_SECRET=replace_me
KAFKA_TOPIC_RAW=payments.raw
KAFKA_TOPIC_PROCESSED=payments.processed
KAFKA_TOPIC_SUSPICIOUS=payments.suspicious

# Consumer
CONSUMER_GROUP=payments-consumer
AUTO_OFFSET_RESET=earliest

# Business rules
SUSPICIOUS_AMOUNT_THRESHOLD=5000
